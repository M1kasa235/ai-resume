# ============================================
# Offer Pilot — AI Job Assistant 配置文件
# 复制此文件为 .env 并修改配置
#   cp .env.example .env
# ============================================

# 应用配置
APP_NAME="Offer Pilot"
DEBUG=true
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# 数据库配置 (MySQL 8.0+)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=ai_job

# JWT 密钥（生产环境必须修改为强密码）
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS（前端地址，生产环境请限制具体域名）
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# LLM 配置 — 阿里百炼 DashScope
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key

# LLM 配置 — DeepSeek（备选）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your_deepseek_api_key

# 搜索引擎 — Tavily（行业资讯 / 面试技巧 / 简历书写，非岗位列表）
TAVILY_API_KEY=your_tavily_api_key
TAVILY_WEB_SEARCH_ENABLED=true
TAVILY_MAX_RESULTS=5
